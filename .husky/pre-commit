echo "🔍 Running pre-commit checks..."

# Run format
echo "📝 Formatting code..."
npm run format

# Add formatted files to staging
git add -A

# Run build (must succeed before we bump versions)
echo "🏗️  Building projects..."
npm run build || exit 1

# Build succeeded - bump versions for changed apps
echo "📦 Bumping versions for changed apps..."
node scripts/bump-version.js patch --if-changed

# Add version-bumped files to staging
git add version.json apps/website/package.json apps/admin/package.json apps/mobile_app/pubspec.yaml 2>/dev/null || true
if [ -f package-lock.json ]; then
  git add package-lock.json 2>/dev/null || true
fi

echo "✅ Pre-commit checks passed!"
