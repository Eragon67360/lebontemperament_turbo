#!/bin/sh

# Exit immediately if a command exits with a non-zero status
set -e

# --- Colors for Logging ---
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m' # No Color

log() {
  echo "${BLUE}🔍 [Pre-Commit]${NC} $1"
}

success() {
  echo "${GREEN}✅ $1${NC}"
}

warn() {
  echo "${YELLOW}⚠️  $1${NC}"
}

# 1. Format Code
log "Formatting code..."
npm run format
git add -A

# 2. Build Projects
log "Building projects..."
# If build fails, the script exits here due to 'set -e'
npm run build 

# 3. Version Bumping
log "Checking for version bumps..."
node scripts/bump-version.js patch --if-changed

# 4. Handle Flutter/Dart Specifics
# We check if pubspec.yaml has changed (staged or unstaged) to decide if we need to refresh flutter
if git diff --name-only --cached apps/mobile_app/pubspec.yaml | grep -q "pubspec.yaml" || git diff --name-only apps/mobile_app/pubspec.yaml | grep -q "pubspec.yaml"; then
  log "Mobile app version changed. Syncing Flutter dependencies..."
  
  # Run inside a subshell so we don't change the main script's working directory
  (
    cd apps/mobile_app
    
    # Run pub get explicitly to update lockfile and package_graph
    # This blocks until finished, preventing the race condition
    flutter pub get --no-example
  )

  # Prepare files to be added
  # We explicitly add pubspec.lock because version bumps usually change the lockfile too
  FILES_TO_ADD="apps/mobile_app/pubspec.yaml apps/mobile_app/pubspec.lock"
  
  # Check for the generated package_graph.json
  GRAPH_FILE="apps/mobile_app/.dart_tool/package_graph.json"
  if [ -f "$GRAPH_FILE" ]; then
    FILES_TO_ADD="$FILES_TO_ADD $GRAPH_FILE"
  else
    warn "Could not find package_graph.json to stage."
  fi

  log "Staging updated Flutter files..."
  # Use -f (force) for .dart_tool files as they are usually gitignored
  git add -f $FILES_TO_ADD
fi

# 5. Stage other specific version files
log "Staging version files..."
git add version.json apps/website/package.json apps/admin/package.json 2>/dev/null || true

if [ -f package-lock.json ]; then
  git add package-lock.json
fi

success "Pre-commit checks passed! Committing..."
