    "@vercel/analytics": "^1.6.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.563.0",
    "motion": "^12.33.0",
    "next": "^16.1.6",
    "papaparse": "^5.5.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-dropzone": "^14.4.0",
    "shake.js": "^1.2.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
