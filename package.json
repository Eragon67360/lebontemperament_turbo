{
  "name": "lebontemperament",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:types": "npm run db:types -w @repo/domain",
    "bump-version": "node scripts/bump-version.js",
    "test:rehearsal-sync": "tsx scripts/test-rehearsal-sync.ts",
    "prepare": "node -e \"if (!process.env.CI && !process.env.VERCEL) { require('child_process').execSync('husky', { stdio: 'inherit' }) }\""
  },
  "dependencies": {
    "@radix-ui/react-visually-hidden": "^1.2.11",
    "@supabase/ssr": "^0.12.6",
    "@supabase/supabase-js": "^2.115.0",
    "@types/papaparse": "^5.5.2",
    "@vercel/analytics": "^1.6.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^0.577.0",
    "motion": "^12.43.0",
    "next": "^16.3.4",
    "papaparse": "^5.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-dropzone": "^14.4.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/react-google-recaptcha": "^2.1.9",
    "autoprefixer": "^10.5.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "fast-xml-parser": ">=5.11.1",
    "h3": ">=1.15.11",
    "husky": "^9.1.7",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "turbo": "^2.10.12",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.19.1",
  "workspaces": [
    "apps/website",
    "apps/admin",
    "packages/*"
  ],
  "overrides": {
    "node-forge": "^1.3.2",
    "fast-xml-parser": ">=5.11.1",
    "@types/mapbox__point-geometry": "npm:@mapbox/point-geometry@1.1.0"
  }
}
