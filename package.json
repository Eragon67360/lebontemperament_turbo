    "husky": "^9.1.7",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.1.18",
    "turbo": "^2.8.3",
    "typescript": "5.9.3",
    "h3": ">=1.15.5",
    "fast-xml-parser": ">=5.3.5"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.9.0",
