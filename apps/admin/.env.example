# ============================================
# ADMIN PROJECT - Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values

# ============================================
# Supabase Configuration
# ============================================
# Your Supabase project URL (found in Supabase dashboard > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous/public key (found in Supabase dashboard > Settings > API)
# This key is safe to expose in the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key (found in Supabase dashboard > Settings > API)
# ⚠️ KEEP THIS SECRET - Never expose this in client-side code
# Used for admin operations that bypass RLS
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================
# Cloudinary Configuration
# ============================================
# Cloudinary cloud name (found in Cloudinary dashboard)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_CLOUD_NAME=your-cloud-name

# Cloudinary API key (found in Cloudinary dashboard > Settings > Security)
CLOUDINARY_API_KEY=your-api-key

# Cloudinary API secret (found in Cloudinary dashboard > Settings > Security)
# ⚠️ KEEP THIS SECRET
CLOUDINARY_API_SECRET=your-api-secret

# ============================================
# Application URLs
# ============================================
# Public URL of the website project (used for preview and migration)
# In production: https://www.lebontemperament.com
# In development: http://localhost:3000
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3000

# Shared secret for the website's POST /api/revalidate (same value as the
# website project's REVALIDATE_SECRET). Mutation routes call it best-effort
# after a change; unset means the website refreshes on its own schedule.
# ⚠️ KEEP THIS SECRET
REVALIDATE_SECRET=

# Public URL of this admin application (used for redirects)
# In production: https://admin.lebontemperament.com (or your admin domain)
# In development: http://localhost:3002
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# ============================================
# Member roster (private Google Sheet)
# ============================================
# The admin reads the members' roster through a Google service account
# (Sheets API, read-only scope). Share the sheet (Viewer) with the service
# account's client_email; do not publish it to the web.
# Without these variables the roster sync routes answer 503; everything else
# works.

# The service account's JSON key, on one line (same format as the Supabase
# functions' GOOGLE_SERVICE_ACCOUNT_JSON).
# ⚠️ KEEP THIS SECRET
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"roster@your-project.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\nyour-key\n-----END PRIVATE KEY-----\n","token_uri":"https://oauth2.googleapis.com/token"}

# The spreadsheet id (the long token in the sheet's URL, between /d/ and /edit)
ROSTER_SHEET_ID=your-sheet-id

# Optional A1 range to read. Default A:ZZ = every used row of the first
# visible tab. Set a tab name (Membres) or Membres!A:H when the roster is not
# the first tab.
# ROSTER_SHEET_RANGE=A:ZZ

# ============================================
# Deployment (Optional)
# ============================================
# Vercel environment (automatically set by Vercel)
# Values: production, preview, development
VERCEL_ENV=development
