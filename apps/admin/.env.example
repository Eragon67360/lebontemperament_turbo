# ============================================
# ADMIN PROJECT - Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values

# ============================================
# Supabase Configuration
# ============================================
# Your Supabase project URL (found in Supabase dashboard > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous/public key (found in Supabase dashboard > Settings > API)
# This key is safe to expose in the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key (found in Supabase dashboard > Settings > API)
# ⚠️ KEEP THIS SECRET - Never expose this in client-side code
# Used for admin operations that bypass RLS
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================
# Cloudinary Configuration
# ============================================
# Cloudinary cloud name (found in Cloudinary dashboard)
CLOUDINARY_CLOUD_NAME=your-cloud-name

# Cloudinary API key (found in Cloudinary dashboard > Settings > Security)
CLOUDINARY_API_KEY=your-api-key

# Cloudinary API secret (found in Cloudinary dashboard > Settings > Security)
# ⚠️ KEEP THIS SECRET
CLOUDINARY_API_SECRET=your-api-secret

# ============================================
# Application URLs
# ============================================
# Public URL of the website project (used for preview and migration)
# In production: https://www.lebontemperament.com
# In development: http://localhost:3000
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3000

# Public URL of this admin application (used for redirects)
# In production: https://admin.lebontemperament.com (or your admin domain)
# In development: http://localhost:3002
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# ============================================
# Excel/CSV Integration (Optional)
# ============================================
# URL to a Google Sheets CSV export or other CSV endpoint
# Used for syncing member data from external sources
# Format: https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/pub?gid=0&single=true&output=csv
NEXT_EXCEL_CSV_URL=https://docs.google.com/spreadsheets/d/your-sheet-id/pub?gid=0&single=true&output=csv

# Alternative: Direct CSV URL (if not using Google Sheets)
EXCEL_CSV_URL=https://your-csv-endpoint.com/data.csv

# ============================================
# Deployment (Optional)
# ============================================
# Vercel environment (automatically set by Vercel)
# Values: production, preview, development
VERCEL_ENV=development
