# Play Store automation for Le Bon Tempérament (see fastlane/README.md).
#
# Every lane talks to the real Play Console. They run from the
# "Play Store" GitHub workflow; the ones that change the store need the
# owner's approval on the `play-store` environment.

default_platform(:android)

METADATA = "fastlane/metadata/android"

# The app's current build number (versionCode), from pubspec.yaml's
# "version: x.y.z+N". Supply needs a release to attach the listing to, even
# when release notes are skipped; without one it looks for a release with no
# version code on the production track and fails.
def current_version_code
  # Lanes run in fastlane/, actions in android/: try both.
  pubspec = ["../../pubspec.yaml", "../pubspec.yaml"].find { |p| File.exist?(p) }
  UI.user_error!("pubspec.yaml not found") unless pubspec
  build = File.read(pubspec)[/^version:\s*\S+\+(\d+)/, 1]
  UI.user_error!("No build number in #{pubspec}") unless build
  build.to_i
end

platform :android do
  desc "Download the current store listing (texts, images, screenshots) into the metadata folder. Read-only."
  lane :download_listing do
    download_from_play_store(metadata_path: METADATA)
  end

  desc "Check the listing in the repository against Google Play without changing anything."
  lane :validate_listing do
    upload_listing(validate_only: true)
  end

  desc "Publish the listing in the repository: texts, icon, feature graphic, screenshots."
  lane :publish_listing do
    upload_listing(validate_only: false)
  end

  desc "Promote an internal-track release. Options: track (alpha = Closed testing, default; or production), version_code, rollout (0-1, production only), validate_only."
  lane :promote do |options|
    version_code = options[:version_code] || UI.user_error!("version_code is required")
    # "alpha" is Closed testing, the highest track until Google grants
    # production access.
    track = options[:track].to_s.strip
    track = "alpha" if track.empty?
    UI.user_error!("track must be alpha or production") unless %w[alpha production].include?(track)
    rollout = options[:rollout].to_s.strip
    # Staged rollouts exist on production only; a testing track gets the
    # whole release.
    full = track != "production" || rollout.empty? || rollout.to_f >= 1.0
    upload_to_play_store(
      track: "internal",
      track_promote_to: track,
      version_code: version_code.to_i,
      # A staged rollout is "inProgress"; 100 % is "completed".
      release_status: full ? "completed" : "inProgress",
      rollout: full ? nil : rollout,
      metadata_path: METADATA,
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: false,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      validate_only: options[:validate_only] == true || options[:validate_only].to_s == "true"
    )
  end

  desc "Print the SHA-256 fingerprints of the certificates Google Play signs the app with, for the website's /.well-known/assetlinks.json (delivery links, #593). Read-only."
  lane :app_signing do
    require "google/apis/androidpublisher_v3"
    require "googleauth"
    require "stringio"

    json = ENV["PLAY_STORE_JSON_KEY"].to_s
    UI.user_error!("PLAY_STORE_JSON_KEY is not set") if json.strip.empty?
    service = Google::Apis::AndroidpublisherV3::AndroidPublisherService.new
    service.authorization = Google::Auth::ServiceAccountCredentials.make_creds(
      json_key_io: StringIO.new(json),
      scope: "https://www.googleapis.com/auth/androidpublisher"
    )
    package = CredentialsManager::AppfileConfig.try_fetch_value(:package_name)
    version_code = current_version_code
    apks = service.list_generatedapks(package, version_code).generated_apks || []
    UI.user_error!("No generated APKs for build #{version_code}") if apks.empty?
    fingerprints = apks.map(&:certificate_sha256_hash).compact.uniq.map do |hash|
      # Hex, or base64 of the raw digest: printed as AA:BB:… like the console.
      hex = hash.match?(/\A\h{64}\z/) ? hash : hash.unpack1("m0").unpack1("H*")
      hex.upcase.scan(/../).join(":")
    end
    fingerprints.each { |f| UI.message("App signing certificate SHA-256 (build #{version_code}): #{f}") }
  end

  private_lane :upload_listing do |options|
    upload_to_play_store(
      metadata_path: METADATA,
      # Every build is released to the internal track first (see
      # android-build-release.yml), so the current one is always there.
      track: "internal",
      version_code: current_version_code,
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_changelogs: true,
      # Only images whose content changed are sent again.
      sync_image_upload: true,
      validate_only: options[:validate_only]
    )
  end
end
