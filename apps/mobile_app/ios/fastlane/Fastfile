# App Store Connect and TestFlight automation for Le Bon Tempérament (see
# fastlane/README.md).
#
# Every lane talks to the real App Store Connect. They run from the
# "iOS TestFlight" GitHub workflow, in the `app-store` environment that
# waits for the owner's approval.

require "shellwords"

default_platform(:ios)

WHAT_TO_TEST = "testflight/what_to_test.txt"

# External TestFlight group the members join through its public link
# (created by hand in App Store Connect; the name must match exactly).
MEMBERS_GROUP = "BT - Testeurs"

# TestFlight « Test Information », shown to members when they join and to
# Apple's beta reviewers. Public texts only: the reviewer's sign-in account
# and the contact details are typed by the owner in App Store Connect.
BETA_APP_INFO = {
  description: "L'appli des membres du Bon Tempérament : répétitions, partitions et concerts.",
  feedback_email: "lebontemperament@gmail.com",
  privacy_policy_url: "https://www.lebontemperament.com/politique-de-confidentialite"
}.freeze

BETA_REVIEW_NOTES = <<~NOTES.strip
  Le Bon Tempérament is a French amateur choir and orchestra association.
  This app is for its members only: rehearsal calendar, sheet music,
  concerts and the member directory. Please use the sign-in account
  provided in this form; accounts are created by the association.
NOTES

# Notes for Apple's App Review of the App Store version.
STORE_REVIEW_NOTES = <<~NOTES.strip
  #{BETA_REVIEW_NOTES}

  The "Mode livraison" screen (background location) is only shown to the
  association's administrators: during the association's fundraising
  deliveries, the volunteer driver's position is shared with the people
  waiting for their order, who follow it on the website. It is not
  available with the review account.
NOTES

def env!(name)
  ENV[name].to_s.strip.empty? ? UI.user_error!("#{name} is not set") : ENV[name]
end

def api_key
  app_store_connect_api_key(
    key_id: env!("ASC_KEY_ID"),
    issuer_id: env!("ASC_ISSUER_ID"),
    key_filepath: env!("ASC_KEY_PATH")
  )
end

# xcodebuild signs with the same API key: automatic signing creates the
# certificate and provisioning profile in the developer account when they
# are missing (cloud signing needs an Admin key).
def signing_xcargs
  [
    "-allowProvisioningUpdates",
    "-authenticationKeyPath #{env!('ASC_KEY_PATH').shellescape}",
    "-authenticationKeyID #{env!('ASC_KEY_ID').shellescape}",
    "-authenticationKeyIssuerID #{env!('ASC_ISSUER_ID').shellescape}"
  ].join(" ")
end

# Names of the internal TestFlight groups without automatic distribution,
# or nil when there are none. Logs every internal group with its tester
# count (no names or emails: the workflow logs are public).
def manual_internal_groups
  app = Spaceship::ConnectAPI::App.find(CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier))
  internal = app.get_beta_groups(includes: "betaTesters").select(&:is_internal_group)
  internal.each do |group|
    UI.message("Internal group « #{group.name} »: #{Array(group.beta_testers).size} tester(s), " \
               "#{group.has_access_to_all_builds ? 'gets every build automatically' : 'builds added by hand'}")
  end
  names = internal.reject(&:has_access_to_all_builds).map(&:name)
  names.empty? ? nil : names
end

platform :ios do
  desc "Archive the app (after `flutter build ios --no-codesign`), sign it for the App Store and upload it to TestFlight."
  lane :beta do
    key = api_key
    # Team and automatic signing set on the project for this run (not as
    # xcargs: gym passes xcargs to the export step too, where xcodebuild
    # refuses duplicate options).
    update_code_signing_settings(
      path: "Runner.xcodeproj",
      targets: ["Runner"],
      use_automatic_signing: true,
      team_id: env!("APPLE_TEAM_ID")
    )
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      output_name: "LeBonTemperament.ipa",
      # Also used by gym for the export (re-signing for the App Store).
      xcargs: signing_xcargs,
      export_team_id: env!("APPLE_TEAM_ID")
    )
    upload_to_testflight(
      api_key: key,
      ipa: "build/LeBonTemperament.ipa",
      # « À tester » shown to testers; set once the build is processed.
      changelog: File.read(WHAT_TO_TEST).strip,
      # Internal groups that don't take every build automatically get this
      # one explicitly. Members are external testers: a group and Apple's
      # beta review, added later with the `members` lane.
      groups: manual_internal_groups,
      distribute_external: false,
      submit_beta_review: false
    )
  end

  desc "Fill the App Store page of the version being prepared: texts, screenshots, age rating, build and review details. Never submits it."
  lane :store do
    key = api_key
    app = Spaceship::ConnectAPI::App.find(CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier))
    UI.user_error!("App not found in App Store Connect") unless app

    # The newest valid build (or BUILD_NUMBER): the page takes its version.
    builds = Spaceship::ConnectAPI::Build.all(
      app_id: app.id,
      build_number: ENV["BUILD_NUMBER"].to_s.strip.empty? ? nil : ENV["BUILD_NUMBER"],
      platform: "IOS",
      processing_states: "VALID",
      limit: 1
    )
    build = builds.first || UI.user_error!("No valid build in App Store Connect")
    UI.message("Build #{build.app_version} (#{build.version})")

    # Texts (metadata/), screenshots (screenshots/, rendered by
    # store/screenshots_test.dart) and age rating. The version being
    # prepared is renamed to the build's version when needed.
    deliver(
      api_key: key,
      app_identifier: app.bundle_id,
      app_version: build.app_version,
      platform: "ios",
      metadata_path: "./fastlane/metadata",
      screenshots_path: "./fastlane/screenshots",
      app_rating_config_path: "./fastlane/age_rating.json",
      skip_binary_upload: true,
      skip_app_version_update: false,
      overwrite_screenshots: true,
      submit_for_review: false,
      run_precheck_before_submit: false,
      # No HTML preview to confirm: the texts are reviewed in the pull request.
      force: true
    )

    version = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
    UI.user_error!("No App Store version being prepared") unless version
    version.select_build(build_id: build.id)
    UI.success("Build #{build.version} attached to version #{version.version_string}")

    # Apple's App Review gets the same contact and sign-in account as the
    # beta review, typed by the owner in TestFlight: copied as is, never
    # printed (the workflow logs are public).
    beta = Spaceship::ConnectAPI.get_beta_app_review_detail(filter: { app: app.id }).to_models.first
    fields = %w[contact_first_name contact_last_name contact_phone contact_email demo_account_name demo_account_password]
    missing = beta ? fields.select { |f| beta.send(f).to_s.strip.empty? } : fields
    if missing.empty?
      attributes = fields.to_h { |f| [f, beta.send(f)] }
      attributes["demo_account_required"] = true
      attributes["notes"] = STORE_REVIEW_NOTES
      detail = version.fetch_app_store_review_detail rescue nil
      detail ? detail.update(attributes: attributes) : version.create_app_store_review_detail(attributes: attributes)
      UI.success("App Review contact and sign-in account copied from the beta review")
    else
      UI.important("App Review details not set: the beta review lacks #{missing.join(', ')}")
    end
  end

  desc "Send the latest TestFlight build to the members' external group and submit it for Apple's beta review."
  lane :members do
    key = api_key
    # pilot skips a group it can't find without saying so: fail instead.
    app = Spaceship::ConnectAPI::App.find(CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier))
    group_names = app.get_beta_groups.map(&:name)
    unless group_names.include?(MEMBERS_GROUP)
      UI.user_error!("TestFlight group « #{MEMBERS_GROUP} » not found (groups: #{group_names.join(', ')})")
    end
    upload_to_testflight(
      api_key: key,
      distribute_only: true,
      # With no .ipa to read it from, pilot would ask for the platform and fail in CI.
      app_platform: "ios",
      # Latest uploaded build unless BUILD_NUMBER picks one.
      build_number: ENV["BUILD_NUMBER"].to_s.strip.empty? ? nil : ENV["BUILD_NUMBER"],
      # fr-FR is the app's primary language: pilot creates the texts when
      # they don't exist yet ("default" only fills existing languages).
      localized_app_info: { "fr-FR" => BETA_APP_INFO, "default" => BETA_APP_INFO },
      localized_build_info: { "fr-FR" => { whats_new: File.read(WHAT_TO_TEST).strip } },
      # Only the notes: pilot leaves the contact and sign-in fields as set
      # in App Store Connect.
      beta_app_review_info: { notes: BETA_REVIEW_NOTES },
      distribute_external: true,
      groups: [MEMBERS_GROUP],
      submit_beta_review: true,
      notify_external_testers: true
    )
  end
end
