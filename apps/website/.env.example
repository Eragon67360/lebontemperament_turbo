# ============================================
# WEBSITE PROJECT - Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values

# ============================================
# Supabase Configuration
# ============================================
# Your Supabase project URL (found in Supabase dashboard > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous/public key (found in Supabase dashboard > Settings > API)
# This key is safe to expose in the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key (found in Supabase dashboard > Settings > API)
# ⚠️ KEEP THIS SECRET - Never expose this in client-side code
# Used for admin operations that bypass RLS
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Personal access token for `npm run db:types` (supabase.com/dashboard/account/tokens)
SUPABASE_ACCESS_TOKEN=

# ============================================
# Cloudinary Configuration
# ============================================
# Cloudinary URL (optional, can be used instead of individual credentials)
# Format: cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_URL=cloudinary://your-api-key:your-api-secret@your-cloud-name

# Cloudinary cloud name (found in Cloudinary dashboard)
CLOUDINARY_CLOUD_NAME=your-cloud-name

# Cloudinary cloud name (public, safe to expose in browser)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# Cloudinary API key (found in Cloudinary dashboard > Settings > Security)
CLOUDINARY_API_KEY=your-api-key

# Cloudinary API secret (found in Cloudinary dashboard > Settings > Security)
# ⚠️ KEEP THIS SECRET
CLOUDINARY_API_SECRET=your-api-secret

# ============================================
# Application URLs
# ============================================
# Base URL of the website (used for SEO, sitemap, canonical URLs, etc.)
# In production: https://www.lebontemperament.com
# In development: http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Admin application URL (used for CSP frame-ancestors to allow admin preview)
# In production: https://admin.lebontemperament.com (or your admin domain)
# In development: http://localhost:3002
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002

# Disable sign-up (set to true to prevent new user registrations)
DISABLE_SIGN_UP=false

# ============================================
# Google Services Configuration
# ============================================
# Google OAuth Client ID (for Google Drive API, Calendar, etc.)
# Found in Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Google OAuth Client Secret
# ⚠️ KEEP THIS SECRET
# Found in Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Google OAuth Redirect URI
# Must match the redirect URI configured in Google Cloud Console
# Format: http://localhost:3000/api/auth/callback/google (for dev)
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# Google OAuth Refresh Token
# ⚠️ KEEP THIS SECRET
# Generated using the generate-token.js script
GOOGLE_REFRESH_TOKEN=your-refresh-token

# Google API Key (general purpose API key)
# Found in Google Cloud Console > APIs & Services > Credentials
GOOGLE_API_KEY=your-google-api-key

# Google Group Email (for newsletter subscriptions)
# The email address of your Google Group
GOOGLE_GROUP_EMAIL=btnewsletter@googlegroups.com

# Google Group ID (for Google Groups API)
# Found in Google Groups settings
GOOGLE_GROUP_ID=your-google-group-id

# Google Calendar API Key (for displaying calendar events)
# Found in Google Cloud Console > APIs & Services > Credentials
NEXT_PUBLIC_GOOGLE_CALENDAR_API_KEY=your-google-calendar-api-key

# Google Calendar ID (for displaying specific calendar)
# Also used as the source calendar for the automated rehearsal sync.
# Share this calendar with GOOGLE_SERVICE_ACCOUNT_JSON.client_email in Supabase
# with "See all event details" permission before enabling the sync cron.
# Format: calendar-id@group.calendar.google.com
NEXT_PUBLIC_GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com

# Google Maps API Key (for displaying maps)
# Found in Google Cloud Console > APIs & Services > Credentials
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Google Site Verification (for Google Search Console)
# Found in Google Search Console > Settings > Ownership verification
GOOGLE_SITE_VERIFICATION=your-verification-code

# ============================================
# Email Configuration (Optional)
# ============================================
# SMTP mailbox (Gmail app password) used by the contact, mobile contact,
# newsletter and anniversary routes. Server-only: never prefix with NEXT_PUBLIC_.
# ⚠️ KEEP THIS SECRET
SMTP_USER=your-mailbox@example.com
SMTP_PASSWORD=your-app-password
# Deprecated names, still read as a fallback until removed from Vercel:
# NEXT_PUBLIC_BURNER_USERNAME / NEXT_PUBLIC_BURNER_PASSWORD

# Receives "new newsletter subscriber" notifications (and anniversary
# testimonials; those fall back to the association's mailbox)
ADMIN_EMAIL=admin@example.com

# Newsletter membership check (Google Apps Script listing the group's members)
GOOGLE_APPS_SCRIPT_URL=

# ============================================
# IndexNow (Optional)
# ============================================
# Shared secret for POST /api/indexnow: callers send it in the
# `x-indexnow-secret` header. While unset, the route refuses every submission.
# ⚠️ KEEP THIS SECRET (generate with `openssl rand -hex 32`)
INDEXNOW_SUBMIT_SECRET=

# ============================================
# Cache revalidation (Optional)
# ============================================
# Shared secret for POST /api/revalidate, which the admin calls after it
# changes concerts, stories, videos, feature flags or gallery photos so the
# cached public pages refresh at once. Same value in the admin project.
# While unset, the route refuses every call (pages still refresh on their own
# every 5 minutes).
# ⚠️ KEEP THIS SECRET (generate with `openssl rand -hex 32`)
REVALIDATE_SECRET=

# ============================================
# Build & Development
# ============================================
# Enable bundle analysis (set to true to analyze bundle size)
ANALYZE=false

# ============================================
# Node Environment
# ============================================
# Automatically set by Next.js, but can be overridden
# Values: development, production, test
NODE_ENV=development


# ============================================
# Mapbox API Key
# ============================================
# Mapbox API Key (for displaying maps)
# Found in Mapbox dashboard
# Use public key (pk.)
NEXT_PUBLIC_MAPBOX_API_KEY=your-mapbox-api-key
