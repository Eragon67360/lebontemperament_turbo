# Copy to apps/e2e/.env (git-ignored) and fill in. Never commit real values.
E2E_USER_EMAIL=
E2E_USER_PASSWORD=

# Defaults shown; override to target other environments.
WEBSITE_URL=https://dev.lebontemperament.com
ADMIN_URL=https://admin-dev.lebontemperament.com

# Vercel Deployment Protection bypass for the admin staging host
# (Vercel project → Settings → Deployment Protection → Protection Bypass for Automation).
VERCEL_AUTOMATION_BYPASS_SECRET=

# Phase 4+ only: used by the global-teardown sweeper (server-side only,
# never exposed to the browser context).
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
