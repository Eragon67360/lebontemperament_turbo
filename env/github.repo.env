# GitHub repository secrets of Eragon67360/lebontemperament_turbo.
# Names and Proton Pass references only: the values live in Proton Pass.
# Push: npm run env:push -- github.repo --apply --prod  (see env/README.md)

# e2e suite (e2e-daily.yml), runs against staging
E2E_USER_EMAIL=pass://LBT Staging/E2E/user_email
E2E_USER_PASSWORD=pass://LBT Staging/E2E/user_password
VERCEL_AUTOMATION_BYPASS_SECRET=pass://LBT Staging/E2E/vercel_bypass_secret

# Nightly encrypted backup of production (db-backup.yml)
SUPABASE_DB_URL=pass://LBT Production/Supabase/db_url
BACKUP_PASSPHRASE=pass://LBT Production/Backup/passphrase

# Mobile app builds (android-build-release.yml, ios-testflight.yml): the apps read production
SUPABASE_URL=pass://LBT Production/Supabase/url
SUPABASE_ANON_KEY=pass://LBT Production/Supabase/anon_key
DRIVE_FOLDER_MAIN=pass://LBT Production/Drive folders/main
DRIVE_FOLDER_ADULTES=pass://LBT Production/Drive folders/adultes
DRIVE_FOLDER_JEUNES=pass://LBT Production/Drive folders/jeunes
DRIVE_FOLDER_ENFANTS=pass://LBT Production/Drive folders/enfants
DRIVE_FOLDER_ORCHESTRE=pass://LBT Production/Drive folders/orchestre
DRIVE_FOLDER_CAHIER_30_ANS=pass://LBT Production/Drive folders/cahier_30_ans
ANDROID_KEYSTORE_BASE64=pass://LBT Production/Android signing/keystore_base64
ANDROID_KEYSTORE_PASSWORD=pass://LBT Production/Android signing/keystore_password
ANDROID_KEY_ALIAS=pass://LBT Production/Android signing/key_alias
ANDROID_KEY_PASSWORD=pass://LBT Production/Android signing/key_password
ANDROID_SERVICE_ACCOUNT_JSON=pass://LBT Production/Google Play/service_account_json
