# GitHub environment `app-store` (ios-testflight.yml). Only this environment holds the
# App Store Connect API key.
# Names and Proton Pass references only: the values live in Proton Pass.
# Push: npm run env:push -- github.app-store --apply --prod  (see env/README.md)

APPLE_TEAM_ID=pass://LBT Production/App Store Connect/team_id
ASC_ISSUER_ID=pass://LBT Production/App Store Connect/issuer_id
ASC_KEY_ID=pass://LBT Production/App Store Connect/key_id
ASC_KEY_P8=pass://LBT Production/App Store Connect/key_p8
