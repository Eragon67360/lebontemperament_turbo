# Admin, Vercel project `lebontemperament-admin`, Preview + Development (admin-dev.lebontemperament.com, PR previews).
# Names and Proton Pass references only: the values live in Proton Pass.
# Push: npm run env:push -- admin.dev --apply  (see env/README.md)
# Shared services (Cloudinary, Google, the revalidation secret) are the same as production.

NEXT_PUBLIC_SUPABASE_URL=pass://LBT Staging/Supabase/url
NEXT_PUBLIC_SUPABASE_ANON_KEY=pass://LBT Staging/Supabase/anon_key
SUPABASE_SERVICE_ROLE_KEY=pass://LBT Staging/Supabase/service_role_key

NEXT_PUBLIC_SITE_URL=pass://LBT Staging/Sites/admin_url
NEXT_PUBLIC_WEBSITE_URL=pass://LBT Staging/Sites/website_url

CLOUDINARY_CLOUD_NAME=pass://LBT Production/Cloudinary/cloud_name
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=pass://LBT Production/Cloudinary/cloud_name
CLOUDINARY_API_KEY=pass://LBT Production/Cloudinary/api_key
CLOUDINARY_API_SECRET=pass://LBT Production/Cloudinary/api_secret

GOOGLE_SERVICE_ACCOUNT_JSON=pass://LBT Production/Google service account/json
ROSTER_SHEET_ID=pass://LBT Production/Google service account/roster_sheet_id
GOOGLE_APPS_SCRIPT_URL=pass://LBT Production/Google APIs/apps_script_url

REVALIDATE_SECRET=pass://LBT Production/Website secrets/revalidate_secret
